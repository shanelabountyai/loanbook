// LoanBook's ledger (clone-owned). The tables are here; the rules that make them a ledger are
// hand-written SQL in migration 20260929000000_ledger_init, which Prisma does not model:
// CHECK constraints per line, a deferred constraint trigger per entry, append-only triggers.

/// Journal entry. Append-only. Checked at commit: at least two lines, debits equal credits, and a
/// loan id wherever an account requires one (D8). A reversal names the entry it reverses; each entry
/// is reversed at most once, and only an entry that exists (task 1.8). `kind` = 'accrual' marks a daily
/// accrual; a partial unique index in migration 20260930200000_ledger_accrual_kind allows one per
/// (loanId, date) (D15). Prisma does not model the index or its CHECK.
model LedgerEntry {
  id              String       @id @default(uuid()) @db.Uuid
  date            DateTime     @db.Date
  loanId          String?
  memo            String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  lines           LedgerLine[]
  reversesEntryId String?      @unique(map: "already_reversed") @db.Uuid
  reverses        LedgerEntry? @relation("Reversal", fields: [reversesEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "dangling_reversal")
  reversedBy      LedgerEntry? @relation("Reversal")
  kind            String?
}

/// One side of an entry. Append-only, and insertable only in the transaction that created its entry.
/// Amounts are whole cents held as numeric, because an integer column rounds a float silently (D12).
model LedgerLine {
  id          String      @id @default(uuid()) @db.Uuid
  entryId     String      @db.Uuid
  entry       LedgerEntry @relation(fields: [entryId], references: [id])
  position    Int // order within the entry, from 0
  account     String
  debitCents  Decimal
  creditCents Decimal

  @@unique([entryId, position])
}
