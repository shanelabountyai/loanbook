            {
              "account": "cash",
              "debit": 100,
              "credit": 0
            },
            {
              "account": "loans_receivable",
              "debit": 0,
              "credit": 100
            }
          ]
        }
      ]
    },
    {
      "id": "VF4",
      "expect": {
        "code": "control_account_mismatch",
        "account": "loans_receivable"
      },
      "note": "Per-loan sub-ledger sum != GL control balance (simulated by dropping loan tag on a stored line)",
      "entries": [
        {
          "id": "E903",
          "date": "2026-01-15",
          "loan_id": "L1",
          "lines": [
            {
              "account": "loans_receivable",
              "debit": 100,
              "credit": 0
            },
            {
              "account": "cash",
              "debit": 0,
              "credit": 100
            }
          ]
        }
      ],
      "tamper": {
        "entry_id": "E903",
        "set_line_loan_id_null": 0
      }
